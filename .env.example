NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0zuATJuN_PleiBACYEujfg_am9Tecum

# 20i reseller API. Keep the real key only in the production environment.
TWENTYI_GENERAL_API_KEY=

# Branded HostShop base URL. Domain searches hand off here for checkout.
HOSTMYWEB_HOSTSHOP_BASE_URL=https://cp.hostmyweb.co

# Bind each HostMyWeb public shared plan to the exact 20i Hosting Package Type ref.
HOSTMYWEB_20I_PACKAGE_TYPE_STARTER=
HOSTMYWEB_20I_PACKAGE_TYPE_BUSINESS=
HOSTMYWEB_20I_PACKAGE_TYPE_PRO=
HOSTMYWEB_20I_PACKAGE_TYPE_AGENCY=

# HostShop product checkout URLs. Starter and Business have current defaults in
# code; Pro and Agency require their exact Product Links from HostShop.
HOSTMYWEB_HOSTSHOP_STARTER_URL=https://cp.hostmyweb.co/domain-required?p=300451-1-dfw&t=1
HOSTMYWEB_HOSTSHOP_BUSINESS_URL=https://cp.hostmyweb.co/domain-required?p=300471-1-dfw&t=1
HOSTMYWEB_HOSTSHOP_PRO_URL=
HOSTMYWEB_HOSTSHOP_AGENCY_URL=

# Expanded catalog Product Links. Copy the exact Product Link from
# My20i > HostShop > Product Catalogue into the matching variable. Until a URL is
# configured, the public product remains visible but falls back to account/signup.
HOSTMYWEB_PRODUCT_WP_STARTER_URL=
HOSTMYWEB_PRODUCT_WP_BUSINESS_URL=
HOSTMYWEB_PRODUCT_WP_PRO_URL=
HOSTMYWEB_PRODUCT_WOO_STORE_URL=
HOSTMYWEB_PRODUCT_WOO_STORE_PRO_URL=
HOSTMYWEB_PRODUCT_VPS_1_URL=
HOSTMYWEB_PRODUCT_VPS_2_URL=
HOSTMYWEB_PRODUCT_VPS_4_URL=
HOSTMYWEB_PRODUCT_BUSINESS_EMAIL_URL=
HOSTMYWEB_PRODUCT_WEBSITE_TURBO_URL=
HOSTMYWEB_PRODUCT_TIMELINE_BACKUPS_URL=
HOSTMYWEB_PRODUCT_PREMIUM_SSL_URL=

